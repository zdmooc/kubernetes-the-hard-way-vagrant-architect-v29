{
  "realm": "kubernetes",
  "enabled": true,
  "displayName": "Kubernetes",
  "registrationAllowed": false,
  "sslRequired": "external",
  "roles": {
    "realm": [
      {"name": "dev"},
      {"name": "ops"},
      {"name": "auditors"},
      {"name": "platform-admins"}
    ]
  },
  "groups": [
    {"name": "dev", "realmRoles": ["dev"]},
    {"name": "ops", "realmRoles": ["ops"]},
    {"name": "auditors", "realmRoles": ["auditors"]},
    {"name": "platform-admins", "realmRoles": ["platform-admins"]}
  ],
  "clients": [
    {
      "clientId": "kubernetes",
      "name": "kubernetes",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
      "webOrigins": ["+"],
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "defaultClientScopes": ["profile", "email", "roles", "groups"]
    }
  ],
  "users": [
    {"username": "alice", "enabled": true, "email": "alice@example.local", "groups": ["dev", "ops"]},
    {"username": "bob", "enabled": true, "email": "bob@example.local", "groups": ["ops", "auditors"]},
    {"username": "carol", "enabled": true, "email": "carol@example.local", "groups": ["platform-admins", "auditors"]}
  ]
}
