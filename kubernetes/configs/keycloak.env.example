# LEGACY_REFERENCE. Canonical Keycloak ownership: keycloak-enterprise-roadmap-v7.
# KC_BOOTSTRAP_ADMIN_USERNAME and KC_BOOTSTRAP_ADMIN_PASSWORD are supplied
# through the local runtime environment and never stored in Git.
KC_HOSTNAME=keycloak-0
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_HTTPS_CERTIFICATE_FILE=/opt/keycloak/conf/server.crt
KC_HTTPS_CERTIFICATE_KEY_FILE=/opt/keycloak/conf/server.key
